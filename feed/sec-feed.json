    {
      "id": "CVE-2024-4577",
      "alias": "cgi-bestfit-rce",
      "title": "PHP-CGI Windows Best-Fit Character Mapping Argument Injection",
      "severity": "CRITICAL",
      "cvss": 9.8,
      "cwe": "CWE-88",
      "affected_versions": ["5.4.*", "5.5.*", "5.6.*", "7.0.*", "7.1.*", "7.2.*", "7.3.*", "7.4.*", "8.0.*", "8.1.*", "8.2.0 - 8.2.19", "8.3.0 - 8.3.7"],
      "remediation_status": {
        "upstream_official": "Patched only in 8.1.29+, 8.2.20+, 8.3.8+",
        "eol_php_armor_c_patch": true,
        "eol_php_armor_runtime_guard": true
      },
      "detection": {
        "sapi_checks": ["cgi-fcgi", "cgi"],
        "os_checks": ["Windows", "All (if behind reverse proxies converting charset)"]
      },
      "description": "When PHP is configured in CGI mode, Windows Unicode Best-Fit character conversion maps soft hyphen (%ad) and related characters to ASCII dash (-), allowing arbitrary command-line switch injection (-d allow_url_include=1)."
    },
    {
      "id": "CVE-2024-2961",
      "alias": "iconv-filter-rce",
      "title": "glibc iconv ISO-2022-CN-EXT Buffer Overflow via php://filter",
      "severity": "CRITICAL",
      "cvss": 9.8,
      "cwe": "CWE-122",
      "affected_versions": ["5.4.*", "5.5.*", "5.6.*", "7.0.*", "7.1.*", "7.2.*", "7.3.*", "7.4.*", "8.0.*", "8.1.*", "8.2.*", "8.3.*"],
      "remediation_status": {
        "upstream_official": "OS-level patch in glibc",
        "eol_php_armor_c_patch": false,
        "eol_php_armor_runtime_guard": true
      },
      "detection": {
        "signature_keywords": ["convert.iconv.", "ISO-2022-CN-EXT"]
      },
      "description": "Exploiting vulnerable glibc iconv conversion routines via complex php://filter sequences leads to heap buffer overflow and unauthenticated remote code execution in any script that accepts arbitrary file names or URLs."
    },
    {
      "id": "CVE-2018-17082",
      "alias": "phar-deserialization",
      "title": "Arbitrary Object Injection via phar:// Stream Wrapper",
      "severity": "HIGH",
      "cvss": 8.1,
      "cwe": "CWE-502",
      "affected_versions": ["5.4.*", "5.5.*", "5.6.*", "7.0.*", "7.1.*", "7.2.*"],
      "remediation_status": {
        "upstream_official": "Patched in 7.3+",
        "eol_php_armor_c_patch": true,
        "eol_php_armor_runtime_guard": true
      },
      "detection": {
        "ini_checks": [
          { "directive": "phar.readonly", "recommended": "On" }
        ],
        "signature_keywords": ["phar://"]
      },
      "description": "Passing user input to file operation functions (file_exists, is_dir, include) using the phar:// stream wrapper automatically triggers deserialization of phar metadata, leading to POP gadget execution."
    },
    {
      "id": "CVE-2016-10033",
      "alias": "mail-escapeshellcmd-rce",
      "title": "sendmail -X Parameter Injection via mail() 5th Argument",
      "severity": "CRITICAL",
      "cvss": 9.8,
      "cwe": "CWE-88",
      "affected_versions": ["5.4.*", "5.5.*", "5.6.*", "7.0.*", "7.1.*", "7.2.*", "7.3.*", "7.4.*"],
      "remediation_status": {
        "upstream_official": "Partially addressed in PHPMailer / SwiftMailer",
        "eol_php_armor_c_patch": false,
        "eol_php_armor_runtime_guard": true
      },
      "detection": {
        "signature_keywords": ["-X", "-OQueueDirectory", "-C"]
      },
