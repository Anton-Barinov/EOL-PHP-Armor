  "vulnerabilities": [
    {
      "id": "CVE-2026-109618",
      "alias": "php2shell-oom",
      "title": "Multipart Form-Data OOM Bailout State Corruption & Unauthenticated RCE",
      "severity": "CRITICAL",
      "cvss": 9.8,
      "cwe": "CWE-400 / CWE-119",
      "affected_versions": ["5.4.*", "5.5.*", "5.6.*", "7.0.*", "7.1.*", "7.2.*", "7.3.*", "7.4.*", "8.0.*", "8.1.*"],
      "remediation_status": {
        "upstream_official": "UNSUPPORTED (EOL)",
        "eol_php_armor_c_patch": true,
        "eol_php_armor_runtime_guard": true
      },
      "detection": {
        "ini_checks": [
          { "directive": "session.upload_progress.enabled", "vulnerable_value": "1" }
        ],
        "signature_keywords": ["PHP_SESSION_UPLOAD_PROGRESS", "multipart/form-data"]
      },
      "c_patches": [
        "php-5.4/php-5.4-enhanced-universal.patch",
        "php-5.5/php-5.5-enhanced-universal.patch",
        "php-5.6/php-5.6-enhanced-universal.patch",
        "php-7.0/php-7.0-enhanced-universal.patch",
        "php-7.1/php-7.1-enhanced-universal.patch",
        "php-7.2/php-7.2-enhanced-universal.patch",
        "php-7.3/php-7.3-enhanced-universal.patch",
        "php-7.4/php-7.4-enhanced-universal.patch",
        "php-8.0/php-8.0-enhanced-universal.patch",
        "php-8.1/php-8.1-enhanced-universal.patch"
      ],
      "description": "During multipart form processing with session upload progress enabled, memory exhaustion during boundary parsing triggers zend_bailout without releasing multipart header pointers, leaving memory in an inconsistent state and permitting remote code execution."
    },
    {
      "id": "CVE-2026-109619",
